<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
>
$for(entries)$
  <url>
    <loc>$site-baseUrl$$url$</loc>$if(lastModifiedAt)$
    <lastmod>$lastModifiedAt$</lastmod>$else$$if(date)$
    <lastmod>$date$</lastmod>$endif$$endif$
    <changefreq>$if(home)$daily$else$weekly$endif$</changefreq>
    <priority>$if(home)$1.0$else$0.8$endif$</priority>
  </url>
$endfor$
</urlset>
