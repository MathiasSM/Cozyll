cabal-version:      3.14

name:               cozyll
version:            3.4.3.1
synopsis:           Custom site generator engine using Hakyll
description:
    Custom static site generator built with Hakyll.
    Source: <https://github.com/MathiasSM/Cozyll>

homepage:           https://cozyll.mathiassm.dev
bug-reports:        github.com/MathiasSM/Cozyll/issues
category:           Data, Web

author:             Mathias San Miguel
maintainer:         mathiassanmiguel@gmail.com

extra-doc-files:    README.md, CHANGELOG.md
extra-source-files:
    templates/*.html
    templates/*.xml
    assets/css/*.css
    schema/*.json
    schema/*.yaml
    schema/example.ruby-data.NOTICE
    docs/authoring.md
    docs/theming.md
    docs/consumer-ci.md

license:            BSD-3-Clause
license-file:       LICENSE.txt

build-type:         Simple

source-repository head
  type:     git
  location: https://github.com/MathiasSM/Cozyll

common shared
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    DeriveGeneric
  ghc-options:      -Wall -Wcompat -Wincomplete-record-updates

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Cozyll.Accessibility
                  , Cozyll.Brand
                  , Cozyll.BuildState
                  , Cozyll.CleanURL
                  , Cozyll.Cli
                  , Cozyll.Cli.Data
                  , Cozyll.Compile
                  , Cozyll.Config
                  , Cozyll.Content
                  , Cozyll.Context
                  , Cozyll.Context.Aside
                  , Cozyll.Context.Author
                  , Cozyll.Context.Data
                  , Cozyll.Context.Feed
                  , Cozyll.Context.Language
                  , Cozyll.Context.Nav
                  , Cozyll.Context.Project
                  , Cozyll.Context.Site
                  , Cozyll.Context.Social
                  , Cozyll.Context.SocialMeta
                  , Cozyll.Discover
                  , Cozyll.Domain.Author
                  , Cozyll.Domain.Feed
                  , Cozyll.Domain.Language
                  , Cozyll.Domain.Nav
                  , Cozyll.Domain.Post
                  , Cozyll.Domain.Project
                  , Cozyll.Domain.Social
                  , Cozyll.Domain.Website
                  , Cozyll.Filters
                  , Cozyll.Format
                  , Cozyll.Html
                  , Cozyll.Init
                  , Cozyll.JsonLd
                  , Cozyll.Localization
                  , Cozyll.Metadata
                  , Cozyll.Paths
                  , Cozyll.Rules
                  , Cozyll.Rules.Assets
                  , Cozyll.Rules.AuthorPages
                  , Cozyll.Rules.Favicon
                  , Cozyll.Rules.Feed
                  , Cozyll.Rules.PostGroup
                  , Cozyll.Rules.Redirects
                  , Cozyll.Rules.Showcase
                  , Cozyll.Rules.SinglePages
                  , Cozyll.Rules.Sitemap
                  , Cozyll.Rules.Validate
                  , Cozyll.Rules.WellKnown
                  , Cozyll.Ruby
                  , Cozyll.Ruby.Derive
                  , Cozyll.Ruby.Index
                  , Cozyll.Ruby.Sources
                  , Cozyll.Theme
                  , Cozyll.Yaml
  other-modules: Paths_cozyll
  autogen-modules: Paths_cozyll
  build-depends:    base         >= 4 && < 5
                  , aeson        >= 2.2 && < 3
                  , bytestring   >= 0.11 && < 0.13
                  , containers   >= 0.6 && < 0.8
                  , crypton      >= 1.0 && < 3
                  , directory    >= 1.3 && < 2
                  , file-embed   >= 0.0.15 && < 0.1
                  , http-client  >= 0.7 && < 0.8
                  , http-client-tls >= 0.3 && < 0.5
                  , http-types   >= 0.12 && < 0.13
                  , filepath     >= 1.5 && < 2
                  , memory       >= 0.18 && < 0.19
                  , jsonschema   >= 0.3 && < 0.4
                  , mtl          >= 2.3 && < 3
                  , optparse-applicative >= 0.18 && < 0.20
                  , scientific   >= 0.3 && < 0.4
                  , text         >= 2.1 && < 3
                  , time         >= 1.12 && < 2
                  , pandoc       >= 3.12 && < 4
                  , pandoc-types >= 1.23 && < 2
                  , tagsoup      >= 0.14 && < 1
                  , template-haskell >= 2.20 && < 2.24
                  , zip-archive  >= 0.4 && < 0.6
                  , unicode-transforms >= 0.4 && < 0.5
                  , yaml         >= 0.11 && < 1
                  , hakyll       == 4.17.*

executable cozyll
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base
                  , cozyll
                  , hakyll
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          SpecMain.hs
  hs-source-dirs:   test
  other-modules:    Cozyll.TestUtils
                  , Cozyll.Fixture
                  , Cozyll.AccessibilitySpec
                  , Cozyll.AsideSpec
                  , Cozyll.AuthorSpec
                  , Cozyll.BrandSpec
                  , Cozyll.BuildStateSpec
                  , Cozyll.CacheSpec
                  , Cozyll.CleanURLSpec
                  , Cozyll.CliSpec
                  , Cozyll.ConfigCacheSpec
                  , Cozyll.ContentSpec
                  , Cozyll.CssSpec
                  , Cozyll.DataSpec
                  , Cozyll.FeedSpec
                  , Cozyll.Fixture
                  , Cozyll.FormatSpec
                  , Cozyll.HtmlSpec
                  , Cozyll.InitSpec
                  , Cozyll.JsonLdSpec
                  , Cozyll.LanguageSpec
                  , Cozyll.LocalizationExampleSpec
                  , Cozyll.MediaSpec
                  , Cozyll.MetadataSpec
                  , Cozyll.NavSpec
                  , Cozyll.PostSpec
                  , Cozyll.ProjectSpec
                  , Cozyll.RedirectsSpec
                  , Cozyll.RubySpec
                  , Cozyll.RubySourcesSpec
                  , Cozyll.CliDataSpec
                  , Cozyll.RubyIndexSpec
                  , Cozyll.RubyDeriveSpec
                  , Cozyll.RubyFilterSpec
                  , Cozyll.RubyVerifySpec
                  , Cozyll.SocialMetaSpec
                  , Cozyll.SocialSpec
                  , Cozyll.ThemeSpec
                  , Cozyll.ValidateSpec
                  , Cozyll.WebsiteSpec
  build-depends:    base
                  , hakyll
                  , cozyll
                  , aeson
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , pandoc
                  , tasty
                  , tasty-ant-xml
                  , tasty-hunit
                  , tasty-quickcheck
                  , temporary
                  , text
                  , time
                  , directory
                  , filepath
                  , temporary
                  , yaml
  ghc-options:      -threaded

test-suite golden
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          GoldenMain.hs
  hs-source-dirs:   test
  other-modules:    Cozyll.Fixture
                  , Golden
  build-depends:    base
                  , hakyll
                  , cozyll
                  , tasty
                  , tasty-ant-xml
                  , tasty-golden
                  , bytestring
                  , directory
                  , filepath
                  , temporary
  ghc-options:      -threaded
